# Database Configuration (PostgreSQL with pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/attendance_db

# Camera Settings (0 for default webcam, or rtsp:// stream URL)
CAMERA_SOURCE=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# Recognition & Matching Parameters
# Derived via ROC / Youden's J statistic (see Section 4.3 and derive_threshold.py)
MATCH_THRESHOLD=0.62

# Temporal Debouncing (Section 4.5)
# Requires at least DEBOUNCE_FRAMES matches out of DEBOUNCE_WINDOW rolling frames
DEBOUNCE_FRAMES=5
DEBOUNCE_WINDOW=7

# Liveness Detection (Section 4.4 - Soukupova & Cech Eye Aspect Ratio)
LIVENESS_EAR_THRESHOLD=0.21
LIVENESS_CONSECUTIVE_FRAMES=2
LIVENESS_WINDOW_SECONDS=3.0

# Active Classroom / Office Session
CURRENT_SESSION_ID=CS101-2026-09-27-09AM

# Application & Security
FLASK_SECRET_KEY=dev-secret-key-change-in-production-12345
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# File Storage Paths
UNKNOWN_FACE_DIR=./static/unknown_faces
ENROLLED_FACES_DIR=./static/enrolled_faces
YUNET_MODEL_PATH=./models/face_detection_yunet_2023mar.onnx
DLIB_PREDICTOR_PATH=./models/shape_predictor_68_face_landmarks.dat
